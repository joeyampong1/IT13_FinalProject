// Handle user profile routes with role parameter
else if (path.StartsWith("user-profile/role/"))
{
    var role = path.Substring("user-profile/role/".Length).ToLower();
    string baseRoute = "/";
    string roleName = "";
    
    // Set the base route based on the role
    switch (role.ToLower())
    {
        case "nurse":
            baseRoute = "/nurse-dashboard";
            roleName = "Nurse";
            break;
        case "doctor":
            baseRoute = "/doctor-dashboard";
            roleName = "Doctor";
            break;
        case "billing":
            baseRoute = "/billing-dashboard";
            roleName = "Billing";
            break;
        case "inventory":
            baseRoute = "/inventory-dashboard";
            roleName = "Inventory";
            break;
        default: // admin
            baseRoute = "/dashboard";
            roleName = "Admin";
            break;
    }
    
    <DashboardLayout BaseRoute="@baseRoute">
        <UserProfile Role="@roleName" />
    </DashboardLayout>
}
// Fallback for old user profile routes
else if (path == "user-profile" || 
         path == "doctor-user-profile" || 
         path == "nurse-user-profile" || 
         path == "billing-user-profile" || 
         path == "inventory-user-profile")
{
    // For backward compatibility, redirect to the new URL format
    var role = path == "user-profile" ? "admin" : path.Split('-')[0].ToLower();
    Navigation.NavigateTo($"/user-profile/role/{role}", forceLoad: true);
    return;
}
else if (path == "roles-permissions")
