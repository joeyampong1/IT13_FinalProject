                <div class="nurse-view-value">@ViewingNote.Content</div>
            </div>

            <div class="nurse-view-section">
                <h3 class="nurse-view-section-title">Additional Info</h3>
                <div class="nurse-view-info-grid">
                    <div class="nurse-view-info-item">
                        <span class="nurse-view-info-label">Pain Scale:</span>
                        <span class="nurse-view-info-value">2/10</span>
                    </div>
                    <div class="nurse-view-info-item">
                        <span class="nurse-view-info-label">Mood:</span>
                        <span class="nurse-view-info-value">Comfortable</span>
                    </div>
                    <div class="nurse-view-info-item">
                        <span class="nurse-view-info-label">Activity:</span>
                        <span class="nurse-view-info-value">Ambulatory</span>
                    </div>
                    <div class="nurse-view-info-item">
                        <span class="nurse-view-info-label">Nutrition:</span>
                        <span class="nurse-view-info-value">Tolerating</span>
                    </div>
                </div>
            </div>

            <div class="nurse-modal-footer-single">
                <button class="nurse-btn-close" @onclick="CloseViewNoteModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private class NursingNote
    {
        public string Id { get; set; } = "";
        public string PatientName { get; set; } = "";
        public string PatientEmail { get; set; } = "";
        public string NoteType { get; set; } = "";
        public string DateTime { get; set; } = "";
        public string Status { get; set; } = "";
        public string Content { get; set; } = "";
        public string Time { get; set; } = "";
        public string Room { get; set; } = "";
        public string Administered { get; set; } = "";
        public string Observation { get; set; } = "";
        public string Note { get; set; } = "";
        public string Tags { get; set; } = "";
    }

    private bool ShowNewNote { get; set; } = false;
    private bool ShowEditNote { get; set; } = false;
    private bool ShowViewNote { get; set; } = false;

    private NursingNote NewNote = new();
    private NursingNote EditingNote = new();
    private NursingNote ViewingNote = new();

    // Patient search dropdown states
    private string NewPatientSearch { get; set; } = "";
    private string EditPatientSearch { get; set; } = "";
    private bool ShowNewPatientDropdown { get; set; } = false;
    private bool ShowEditPatientDropdown { get; set; } = false;

    private readonly string[] AvailablePatients = new string[]
    {
        "Juan Dela Cruz - Room 201",
        "Ana Santos - Room 205",
        "Himeko Murata - Room 301",
        "Yae Miko - Room 105",
        "Black Swan - Room 210",
        "Ruan Mei - Room 302",
        "Bronya Rand - Room 401"
    };

    private IEnumerable<string> FilteredNewPatients =>
        string.IsNullOrWhiteSpace(NewPatientSearch)
            ? AvailablePatients
            : AvailablePatients.Where(p => p.Contains(NewPatientSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> FilteredEditPatients =>
        string.IsNullOrWhiteSpace(EditPatientSearch)
            ? AvailablePatients
            : AvailablePatients.Where(p => p.Contains(EditPatientSearch, StringComparison.OrdinalIgnoreCase));

    private readonly NursingNote[] Notes = new NursingNote[]
    {
        new() {
            Id = "01",
            PatientName = "Juan Dela Cruz",
            PatientEmail = "juandelacruz@gmail.com",
            NoteType = "Care Provided",
            DateTime = "03/09/24",
