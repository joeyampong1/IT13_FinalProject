@page "/nurse-notes"
@layout Layout.DashboardLayout

<div class="nurse-notes-page">
    <header class="dashboard-header">
        <div>
            <h1 class="dashboard-title">Nursing Notes</h1>
            <p class="dashboard-subtitle">Welcome back Clinical Staff!</p>
        </div>

        <div class="dashboard-user-info">
            <span class="dashboard-user-email">nurse@gmail.com</span>
            <div class="dashboard-user-avatar">
                👤
            </div>
            <span class="dashboard-user-name">Clinical</span>
        </div>
    </header>

    <section class="pm-overview">
        <div class="pm-overview-header">
            <h2 class="pm-section-title">Nursing Notes</h2>
            <div class="pm-show-entries">
                <span>Show</span>
                <select>
                    <option>5</option>
                    <option>10</option>
                    <option>25</option>
                </select>
                <span>entries</span>
            </div>
        </div>

        <div class="pm-filters-row">
            <div class="pm-search-row">
                <div class="pm-search-box">
                    <span class="pm-search-icon"></span>
                    <input class="pm-search-input" placeholder="Search Notes" />
                </div>

                <div class="pm-actions">
                    <button class="activity-action-btn">Sort</button>
                    <button class="activity-action-btn">Filters</button>
                    <button class="activity-action-btn" @onclick="ShowNewNoteModal">+ New notes</button>
                </div>
            </div>
        </div>

        <div class="nurse-content-scroll">
            <h2 class="nurse-shift-title">TODAY'S SHIFT NOTES (Morning: 7AM-3PM)</h2>

            <div class="nurse-notes-list">
                @foreach (var note in Notes)
                {
                    <div class="nurse-note-card">
                        <div class="nurse-note-header">
                            <span class="nurse-note-time">⏰ @note.Time | @note.Room - @note.PatientName</span>
                        </div>
                        <div class="nurse-note-body">
                            <div class="nurse-note-item">
                                <span class="nurse-note-icon">💊</span>
                                <span class="nurse-note-label">Administered:</span>
                                <span class="nurse-note-text">@note.Administered</span>
                            </div>
                            <div class="nurse-note-item">
                                <span class="nurse-note-icon">👁️</span>
                                <span class="nurse-note-label">Observation:</span>
                                <span class="nurse-note-text">@note.Observation</span>
                            </div>
                            <div class="nurse-note-item">
                                <span class="nurse-note-icon">📝</span>
                                <span class="nurse-note-label">Note:</span>
                                <span class="nurse-note-text">@note.Note</span>
                            </div>
                            <div class="nurse-note-item">
                                <span class="nurse-note-icon">🏷️</span>
                                <span class="nurse-note-label">Tags:</span>
                                <span class="nurse-note-text">@note.Tags</span>
                            </div>
                        </div>
                        <div class="nurse-note-footer">
                            <button class="nurse-note-edit-btn" @onclick="() => ShowEditNoteModal(note)">✏️ Edit</button>
                            <button class="nurse-note-view-btn" @onclick="() => ShowViewNoteModal(note)">👁️ View</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@* New Note Modal *@
@if (ShowNewNote)
{
    <div class="nurse-modal-overlay" @onclick="CloseNewNoteModal">
        <div class="nurse-modal" @onclick:stopPropagation="true">
            <h2 class="nurse-modal-title">Add Nursing Entry</h2>

            <div class="nurse-form-group">
                <label class="nurse-form-label">Patient</label>
                <div class="nurse-patient-select-wrapper">
                    <input type="text"
                           class="nurse-patient-input"
                           placeholder="Select Patient"
                           @bind="NewPatientSearch"
                           @oninput="OnNewPatientSearchInput"
                           @onfocus="() => ShowNewPatientDropdown = true" />
                    <span class="nurse-dropdown-icon">▼</span>

                    @if (ShowNewPatientDropdown && FilteredNewPatients.Any())
                    {
                        <div class="nurse-patient-dropdown">
                            @foreach (var patient in FilteredNewPatients)
                            {
                                <div class="nurse-patient-option" @onclick="() => SelectNewPatient(patient)">
                                    @patient
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="nurse-form-group">
                <label class="nurse-form-label">Vital Signs</label>
                <div class="nurse-vitals-display">
                    <span>BP: 130/85 | Temp: 37.0°C | Pulse: 78 | SpO₂: 97%</span>
                    <div class="nurse-vitals-time">(Last taken: 02:00 PM)</div>
                </div>
            </div>

            <div class="nurse-form-group">
                <label class="nurse-form-label">Category</label>
                <select class="nurse-form-select" @bind="NewNote.NoteType">
                    <option value="">Select Category</option>
                    <option value="Care Provided">Care Provided</option>
                    <option value="Medication">Medication</option>
                    <option value="Assessment">Assessment</option>
                </select>
            </div>

            <div class="nurse-form-group">
                <label class="nurse-form-label">Details</label>
                <textarea class="nurse-form-textarea" rows="4" @bind="NewNote.Content"
                          placeholder="Enter care details..."></textarea>
            </div>

            <div class="nurse-form-section">
                <h3 class="nurse-form-section-title">Additional Info</h3>
                <div class="nurse-form-row">
                    <div class="nurse-form-group-inline">
                        <label class="nurse-form-label">Pain Scale:</label>
                        <select class="nurse-form-select-small">
                            <option>2/10</option>
                            <option>0/10</option>
                            <option>5/10</option>
                        </select>
                    </div>
                    <div class="nurse-form-group-inline">
                        <label class="nurse-form-label">Mood:</label>
                        <select class="nurse-form-select-small">
                            <option>Comfortable</option>
                            <option>Anxious</option>
                            <option>Calm</option>
                        </select>
                    </div>
                </div>
                <div class="nurse-form-row">
                    <div class="nurse-form-group-inline">
                        <label class="nurse-form-label">Activity:</label>
                        <select class="nurse-form-select-small">
                            <option>Ambulatory</option>
                            <option>Bedrest</option>
                            <option>Limited</option>
                        </select>
                    </div>
                    <div class="nurse-form-group-inline">
                        <label class="nurse-form-label">Nutrition:</label>
                        <select class="nurse-form-select-small">
                            <option>Tolerating</option>
                            <option>NPO</option>
                            <option>Poor</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="nurse-modal-footer">
                <button class="nurse-btn-cancel" @onclick="CloseNewNoteModal">Cancel</button>
                <button class="nurse-btn-save" @onclick="SaveNewNote">Save</button>
            </div>
        </div>
    </div>
}

