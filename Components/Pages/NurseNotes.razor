        },
        new() {
            Id = "02",
            PatientName = "Ana Santos",
            PatientEmail = "anasantos@mail.com",
            NoteType = "Care Provided",
            DateTime = "03/09/24",
            Status = "Complete",
            Content = "Changed abdominal dressing. Wound clean, no signs of infection.",
            Time = "10:30",
            Room = "Room 205",
            Administered = "Changed abdominal dressing",
            Observation = "Wound clean, no signs of infection",
            Note = "Patient tolerated procedure well",
            Tags = "#woundcare #dressing-change"
        },
        new() {
            Id = "03",
            PatientName = "Juan Dela Cruz",
            PatientEmail = "juandelacruz@gmail.com",
            NoteType = "Communication",
