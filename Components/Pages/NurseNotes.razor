    private void ShowNewNoteModal()
    {
        NewNote = new();
        NewPatientSearch = "";
        ShowNewPatientDropdown = false;
        ShowNewNote = true;
    }

    private void CloseNewNoteModal()
    {
        ShowNewNote = false;
        ShowNewPatientDropdown = false;
