@* View Note Modal *@
@if (ShowViewNote)
{
    <div class="nurse-modal-overlay" @onclick="CloseViewNoteModal">
        <div class="nurse-modal" @onclick:stopPropagation="true">
            <h2 class="nurse-modal-title">Nursing Entry</h2>

            <div class="nurse-view-group">
                <label class="nurse-view-label">Patient</label>
                <div class="nurse-view-value">@ViewingNote.PatientName</div>
            </div>

            <div class="nurse-view-group">
                <label class="nurse-view-label">Vital Signs</label>
                <div class="nurse-view-value">
                    BP: 130/85 | Temp: 37.0°C | Pulse: 78 | SpO₂: 97%
                    <div class="nurse-vitals-time">(Last taken: 02:00 PM)</div>
                </div>
            </div>

            <div class="nurse-view-group">
                <label class="nurse-view-label">Category</label>
                <div class="nurse-view-value">@ViewingNote.NoteType</div>
            </div>

            <div class="nurse-view-group">
