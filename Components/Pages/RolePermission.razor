@page "/roles-permissions"
@layout Layout.DashboardLayout
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

<div class="roles-permissions-page">
    <div class="rp-header">
        <div>
            <h1>Roles & Permissions</h1>
            <p>Manage user roles and their access permissions</p>
        </div>
        <div class="rp-header-actions">
            <div class="rp-search-box">
                <span class="rp-search-icon">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.33333 12.6667C10.2789 12.6667 12.6667 10.2789 12.6667 7.33333C12.6667 4.38781 10.2789 2 7.33333 2C4.38781 2 2 4.38781 2 7.33333C2 10.2789 4.38781 12.6667 7.33333 12.6667Z" stroke="#718096" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14 14L11.1 11.1" stroke="#718096" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <input type="text" class="rp-search-input" placeholder="Search roles..." />
            </div>
            <button class="rp-add-btn" @onclick="ShowAddRoleModal">
                <span class="rp-icon rp-icon-add">+</span>
                Add New Role
            </button>
        </div>
    </div>

    <div class="rp-table-container">
        <table class="rp-table">
            <thead>
                <tr>
                    <th>ROLE NAME</th>
                    <th>DESCRIPTION</th>
                    <th>USERS</th>
                    <th>PERMISSIONS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in roles)
                {
                    <tr>
                        <td>
                            <div class="rp-role-info">
                                <span class="rp-role-icon">
                                    @GetRoleIcon(role.Name)
                                </span>
                                <span>@role.Name</span>
                            </div>
                        </td>
                        <td>@role.Description</td>
                        <td>@role.UserCount users</td>
                        <td>
                            <div class="rp-permissions">
                                @foreach (var permission in role.Permissions.Take(3))
                                {
                                    <span class="rp-permission-tag">@permission</span>
                                }
                                @if (role.Permissions.Count > 3)
                                {
                                    <span class="rp-more-permissions">+@(role.Permissions.Count - 3) more</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="rp-actions-cell">
                                <button class="rp-action-btn rp-edit" @onclick="() => EditRole(role)">
                                    <span class="rp-icon rp-icon-edit"></span>
                                </button>
                                @if (role.Name != "Admin")
                                {
                                    <button class="rp-action-btn rp-delete" @onclick="() => ShowDeleteConfirm(role)">
                                        <span class="rp-icon rp-icon-delete"></span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

@if (showAddEditModal)
{
    <div class="rp-modal-overlay" @onclick="CloseModal">
        <div class="rp-modal" @onclick:stopPropagation>
            <div class="rp-modal-header">
                <h3>@(editingRole == null ? "Add New Role" : "Edit Role")</h3>
                <button class="rp-close-btn" @onclick="CloseModal">&times;</button>
            </div>
            <div class="rp-modal-body">
                <div class="rp-form-group">
                    <label>Role Name</label>
                    <input type="text" class="rp-form-control" @bind="roleName" />
                </div>
                <div class="rp-form-group">
                    <label>Description</label>
                    <textarea class="rp-form-control" @bind="roleDescription"></textarea>
                </div>
                <div class="rp-form-group">
                    <label>Permissions</label>
                    <div class="rp-permissions-grid">
                        @foreach (var permission in allPermissions)
                        {
                            <label class="rp-checkbox-container">
                                <input type="checkbox" 
                                       checked="@(selectedPermissions.Contains(permission))"
                                       @onchange="(e) => TogglePermission(permission, (bool)e.Value)" />
                                <span class="rp-checkmark"></span>
                                @permission
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="rp-modal-footer">
                <button class="rp-btn rp-btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="rp-btn rp-btn-primary" @onclick="SaveRole">
                    @(editingRole == null ? "Create Role" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="rp-modal-overlay" @onclick="CloseDeleteModal">
        <div class="rp-delete-modal" @onclick:stopPropagation>
            <div class="rp-delete-icon">
                <span class="rp-icon rp-icon-warning"></span>
            </div>
            <h3>Delete Role</h3>
            <p>Are you sure you want to delete the role <strong>@roleToDelete?.Name</strong>? This action cannot be undone.</p>
            <div class="rp-delete-actions">
                <button class="rp-btn rp-btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                <button class="rp-btn rp-btn-danger" @onclick="DeleteRole">Delete</button>
            </div>
        </div>
    </div>
}
</div>

@code {
    [Inject] 
    private string CurrentRole
    {
        get
        {
            try
            {
                var uri = Navigation?.Uri?.ToLowerInvariant() ?? string.Empty;
                if (uri.Contains("doctor-")) return "Doctor";
                if (uri.Contains("nurse-")) return "Nurse";
                if (uri.Contains("billing-")) return "Billing";
                if (uri.Contains("inventory-")) return "Inventory";
                return "Admin";
            }
            catch
            {
                return "Admin"; // Default to Admin if there's any error
            }
        }
    }

    private void GoToUserProfile()
    {
        try 
        {
            if (Navigation == null) return;
            
            var role = (CurrentRole ?? string.Empty).ToLowerInvariant();
            var target = "/user-profile";
            
            switch (role)
            {
                case "doctor":
                    target = "/doctor-user-profile";
                    break;
                case "nurse":
                    target = "/nurse-user-profile";
                    break;
                case "billing":
                    target = "/billing-user-profile";
                    break;
                case "inventory":
                    target = "/inventory-user-profile";
                    break;
            }
            
            Navigation.NavigateTo(target, forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Navigation error: {ex.Message}");
            Navigation?.NavigateTo("/user-profile", forceLoad: true);
        }
    }

