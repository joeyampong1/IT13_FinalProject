    private void ShowAddRoleModal()
    {
        editingRole = null;
        roleName = "";
        roleDescription = "";
        selectedPermissions.Clear();
        showAddEditModal = true;
    }

    private void EditRole(Role role)
    {
        editingRole = role;
        roleName = role.Name;
        roleDescription = role.Description;
        selectedPermissions = new List<string>(role.Permissions);
        showAddEditModal = true;
    }

    private void CloseModal()
    {
        showAddEditModal = false;
    }

    private void SaveRole()
    {
        // Here you would typically save to your backend
        if (editingRole == null)
        {
            // Add new role
            roles.Add(new Role
            {
                Name = roleName,
                Description = roleDescription,
                Permissions = new List<string>(selectedPermissions),
                UserCount = 0
            });
        }
        else
        {
            // Update existing role
            var existingRole = roles.FirstOrDefault(r => r.Name == editingRole.Name);
            if (existingRole != null)
            {
                existingRole.Name = roleName;
                existingRole.Description = roleDescription;
                existingRole.Permissions = new List<string>(selectedPermissions);
            }
        }
        
        showAddEditModal = false;
        StateHasChanged();
    }

    private void TogglePermission(string permission, bool isSelected)
    {
        if (isSelected && !selectedPermissions.Contains(permission))
        {
            selectedPermissions.Add(permission);
        }
        else if (!isSelected && selectedPermissions.Contains(permission))
        {
            selectedPermissions.Remove(permission);
        }
    }

    private void ShowDeleteConfirm(Role role)
    {
        roleToDelete = role;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        roleToDelete = null;
    }

    private void DeleteRole()
    {
        if (roleToDelete != null)
        {
            roles.RemoveAll(r => r.Name == roleToDelete.Name);
            showDeleteModal = false;
            roleToDelete = null;
            StateHasChanged();
        }
    }

    private string GetRoleIcon(string roleName)
    {
        return roleName switch
        {
            "Admin" => "👑",
            "Doctor" => "👨‍⚕️",
            "Nurse" => "👩‍⚕️",
            "Billing" => "💵",
            "Inventory" => "📦",
            _ => "👤"
        };
    }

    public class Role
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int UserCount { get; set; }
        public List<string> Permissions { get; set; } = new();
    }



}
