@page "/nurse-vitals-list"
@layout Layout.DashboardLayout

<div class="pm-page">
    <header class="dashboard-header">
        <div>
            <h1 class="dashboard-title">Vital Signs Monitoring</h1>
            <p class="dashboard-subtitle">Welcome back Clinical Staff!</p>
        </div>

        <div class="dashboard-user-info">
            <span class="dashboard-user-email">nurse@gmail.com</span>
            <div class="dashboard-user-avatar">
                👤
            </div>
            <span class="dashboard-user-name">Clinical</span>
        </div>
    </header>

    <section class="pm-overview">
        <div class="pm-overview-header">
            <h2 class="pm-section-title">Vital Sign Record</h2>
            <div class="pm-show-entries">
                <span>Show</span>
                <select>
                    <option>5</option>
                    <option>10</option>
                    <option>25</option>
                </select>
                <span>entries</span>
            </div>
        </div>

        <div class="pm-filters-row">
            <div class="pm-search-row">
                <div class="pm-search-box">
                    <span class="pm-search-icon"></span>
                    <input class="pm-search-input" placeholder="Search Patient" />
                </div>

                <div class="pm-actions">
                    <button class="activity-action-btn">Sort</button>
                    <button class="activity-action-btn">Filters</button>
                </div>
            </div>
        </div>

        <div class="pm-table-outer">
            <div class="pm-table-wrapper">
                <table class="pm-table">
                    <thead>
                        <tr>
                            <th class="pm-col-id">ID</th>
                            <th>Patient Name<br /><span class="pm-subcol">Email</span></th>
                            <th>Assessment Status</th>
                            <th class="pm-col-date">Date of Visit</th>
                            <th class="pm-col-status">Vital Status</th>
                            <th class="pm-col-action">Vital Signs Monitoring</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in ActiveLetter.HasValue ? GetOrderedRows(ActiveLetter.Value) : Rows)
                        {
                            <tr>
                                <td class="pm-col-id">@r.Id</td>
                                <td>
                                    <div class="pm-patient-name">@r.PatientName</div>
                                    <div class="pm-patient-email">@r.PatientEmail</div>
                                </td>
                                <td>@r.AssessmentStatus</td>
                                <td class="pm-col-date">@r.DateOfVisit</td>
                                <td class="pm-col-status">@r.VitalStatus</td>
                                <td class="pm-col-action">
                                    <button class="pm-view-btn" @onclick="() => OpenVitals(r)" aria-label="View vital signs record">
                                        <span class="pm-view-icon"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (ShowPagination)
        {
            <div class="pm-pagination">
                <button class="pm-page-btn">Previous</button>
                <button class="pm-page-number active">1</button>
                <button class="pm-page-number">2</button>
                <button class="pm-page-number">3</button>
                <span class="pm-page-dots">...</span>
                <button class="pm-page-number">8</button>
                <button class="pm-page-btn">Next</button>
            </div>
        }
    </section>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    

    private record VitalRow(string Id, string PatientName, string PatientEmail, string AssessmentStatus, string DateOfVisit, string VitalStatus);

    
    
    private bool ShowPagination { get; set; } = true;
    private bool ShowLetters { get; set; } = false;
    private char? ActiveLetter { get; set; }
    
    private readonly char[] Alphabet =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray();

    private readonly VitalRow[] Rows = new VitalRow[]
    {
        new("01", "Himeko Murata", "himeko_murata@gmail.com", "Pending Assessment", "03/09/24", "No Vitals"),
        new("02", "Yae Miko", "miko.yae@mail.com", "Vital Signs Taken", "03/09/24", "Complete"),
        new("03", "Black Swan", "ms.blkswan@mail.com", "For Doctor Evaluation", "03/09/24", "Complete"),
        new("04", "Ruan Mei", "theRM_ei@gmail.com", "Follow-up Required", "03/09/24", "Partial"),
        new("05", "Bronya Rand", "bronya.rr@mail.com", "Completed", "03/09/24", "Complete"),
    };

    

    

    private IEnumerable<VitalRow> GetOrderedRows(char letter)
    {
        if (string.IsNullOrEmpty(letter.ToString()))
        {
            return Rows;
        }

        var upper = letter.ToString().ToUpper();

        var startsWithLetter = Rows
            .Where(r => (r.PatientName ?? string.Empty).StartsWith(upper, StringComparison.OrdinalIgnoreCase));

        var others = Rows
            .Where(r => !(r.PatientName ?? string.Empty).StartsWith(upper, StringComparison.OrdinalIgnoreCase));

        return startsWithLetter.Concat(others);
    }

    private void TogglePagination()
    {
        ShowPagination = !ShowPagination;
    }

    private void GoToVitalsForm(string patientId)
    {
        Navigation.NavigateTo("/nurse-vitals");
    }

    private void SelectLetter(char letter)
    {
        ShowLetters = true;
        ActiveLetter = letter;
    }

    private void OpenVitals(VitalRow row)
    {
        Navigation.NavigateTo("/nurse-vitals-edit");
    }
}






